# ─── ae-workspace environment ─────────────────────────────────────────────
# Copy to .env (never commit). The API reads these; the web app reads only the
# VITE_* vars at build time.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API (the web app).
WEB_ORIGIN=http://localhost:5173

# --- Supabase (Auth = Google SSO, DB = Postgres, isolation = RLS) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key: server-only. NEVER ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key + URL are the only Supabase values the web app may see.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Restrict SSO to the company domain (backend re-checks this too).
ALLOWED_EMAIL_DOMAIN=attentive.ai

# --- HubSpot (source of truth for follow-ups + activity) ---
# Private-app token. Scopes: crm.objects.deals.read, crm.schemas.deals.read,
# crm.objects.owners.read, plus engagements read for activity verification.
HUBSPOT_TOKEN=
# Portal id, used only to build "Open Deal in HubSpot" deep links.
HUBSPOT_PORTAL_ID=

# --- ROMA (source of truth for Fight Score + AE funnel) ---
# Run ROMA locally: `uvicorn app:app --port 8080` in Project-ROMA.
ROMA_BASE_URL=http://localhost:8080
ROMA_PASSWORD=

# --- Reconciliation cron ---
# Shared secret required on POST /internal/cron/reconcile (Railway cron sends it).
CRON_SECRET=
# Lightweight client refetch interval hint (ms) surfaced to the web app.
VITE_TASKEE_REFETCH_MS=120000

# --- Briefy research providers (net-new + reused adapters) ---
# Reused from beam-qualification-agent / icp-match:
EXA_API_KEY=
FIRECRAWL_API_KEY=
ZOOMINFO_CLIENT_ID=
ZOOMINFO_CLIENT_SECRET=
# Net-new (adapters stubbed until keys provided):
JINA_API_KEY=
SEAMLESS_API_KEY=

# --- Google Calendar (Briefy meetings) ---
# Uses the same Google OAuth as SSO with calendar.readonly scope.
GOOGLE_CALENDAR_ENABLED=false
